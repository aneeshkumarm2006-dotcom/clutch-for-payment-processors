# --- Database ---
MONGODB_URI=mongodb://localhost:27017/paymentprocessorguide

# --- Auth (NextAuth) ---
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# --- SEO team dashboard (/seoteam) ---
# Single shared password the non-technical SEO team uses to sign in at /seoteam.
SEO_DASHBOARD_PASSWORD=change-me-strong-shared-password
# Secret used to sign the /seoteam session cookie (separate from NEXTAUTH_SECRET).
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# --- Image hosting (Cloudinary; abstracted behind lib/upload.ts) ---
# Copy the "API environment variable" from your Cloudinary dashboard
# (Settings → API Keys). Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# ...or set the three discrete vars instead of CLOUDINARY_URL:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Admin seed (used by scripts/seed-admin.ts) ---
ADMIN_SEED_EMAIL=admin@paymentprocessorguide.test
ADMIN_SEED_PASSWORD=change-me-in-production
# ADMIN_SEED_NAME=Admin            # optional, defaults to "Admin"
# ADMIN_SEED_ROLE=admin            # optional [Phase 2]: 'admin' | 'editor' (or pass --role=editor)

# --- Analytics Hub (/analyticshub) ---
# ONE secret governs all hub encryption + the session cookie (HKDF-derived).
# Generate with: openssl rand -base64 32  — paste the raw 44-char output, no quotes.
# Changing it later orphans everything already stored (tokens, password). Redeploy
# after adding it — env vars only bake into deployments created afterwards.
ANALYTICSHUB_SECRET_KEY=
# Shared Google OAuth app (optional but enables "Sign in with Google" for GA4+GSC;
# without it, only the service-account path shows). One app serves all deployments.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Storage: the hub reuses MONGODB_URI above (an `analyticshub_config` collection).
# No Upstash/KV needed. Meta + Google Ads credentials are entered in the dashboard.

# --- Public site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- IndexNow (Bing, Yandex, Naver, Seznam, Yep — NOT Google) ---
# Pings the engines the moment a page is published, changed or removed, instead
# of waiting for a crawl. Free, no account beyond Bing Webmaster Tools, no API.
# Bing matters out of proportion to its share: it is the retrieval layer behind
# ChatGPT Search, so time-to-index there is time-to-citation.
#
# Generate the key at https://www.bing.com/webmasters -> IndexNow. It is 8 to 128
# characters of a-z A-Z 0-9 and dashes.
#
# TWO things must match or every submission 403s:
#   1. this variable, and
#   2. a committed `public/<key>.txt` whose entire contents are that same key
#      (nothing else, no newline needed), so the file serves at
#      https://<your-domain>/<key>.txt
#
# The key is PUBLIC by design — it is served from your own domain as the proof of
# ownership. It is not a secret and does not belong in a secrets manager, though
# GitHub Actions still reads it from a repo secret for convenience.
#
# Unset, everything no-ops silently. Submissions are also skipped whenever
# VERCEL_ENV is not "production", so previews and dev never ping.
INDEXNOW_KEY=

# --- Email notifications (optional; leads/submissions notify when set) ---
# Sent over plain SMTP from our own mailbox — no third-party sending service.
# Leave SMTP_USER/SMTP_PASS empty and every send is a silent no-op.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Google App Password (16 chars, requires 2-Step Verification) — not the login password.
SMTP_PASS=
# From address. Gmail rewrites this unless it matches SMTP_USER or a verified alias.
# EMAIL_FROM=Payment Processor Guide <automations@davnoot.com>
# Where lead/submission notifications go — comma-separated for several owners.
# Falls back to SiteSettings.contactEmail when unset.
# LEADS_NOTIFY_EMAIL=gunin@davnoot.com,automations@davnoot.com

# --- Spam protection: Cloudflare Turnstile (optional; an ENV-VAR-ONLY switch) ---
# Leave both blank and nothing changes: no widget is injected, no token is
# required, and the honeypot + rate limits + classifier keep working as they do
# today. Set BOTH and every public POST (leads, submissions, reviews) starts
# requiring a valid token — no code edit needed.
#
# The site key is served to the browser from /api/spam/config rather than baked
# into page markup, so switching it on never touches a generated page.
#
# Get them at https://dash.cloudflare.com → Turnstile → Add widget.
# Site key is public (starts 0x4AAA...); the secret is NOT (starts 0x4AAA... too,
# so don't mix them up — the secret is the one Cloudflare hides behind "Click to
# reveal"). Never commit the secret; this file is .env.example, the real values
# belong in .env.local (gitignored) and in the host's env settings.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
