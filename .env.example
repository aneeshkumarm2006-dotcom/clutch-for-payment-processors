# --- Database ---
MONGODB_URI=mongodb://localhost:27017/paymentprocessorguide

# --- Auth (NextAuth) ---
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# --- SEO team dashboard (/seoteam) ---
# Single shared password the non-technical SEO team uses to sign in at /seoteam.
SEO_DASHBOARD_PASSWORD=change-me-strong-shared-password
# Secret used to sign the /seoteam session cookie (separate from NEXTAUTH_SECRET).
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# --- Image hosting (Cloudinary; abstracted behind lib/upload.ts) ---
# Copy the "API environment variable" from your Cloudinary dashboard
# (Settings → API Keys). Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# ...or set the three discrete vars instead of CLOUDINARY_URL:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Admin seed (used by scripts/seed-admin.ts) ---
ADMIN_SEED_EMAIL=admin@paymentprocessorguide.test
ADMIN_SEED_PASSWORD=change-me-in-production
# ADMIN_SEED_NAME=Admin            # optional, defaults to "Admin"
# ADMIN_SEED_ROLE=admin            # optional [Phase 2]: 'admin' | 'editor' (or pass --role=editor)

# --- Analytics Hub (/analyticshub) ---
# ONE secret governs all hub encryption + the session cookie (HKDF-derived).
# Generate with: openssl rand -base64 32  — paste the raw 44-char output, no quotes.
# Changing it later orphans everything already stored (tokens, password). Redeploy
# after adding it — env vars only bake into deployments created afterwards.
ANALYTICSHUB_SECRET_KEY=
# Shared Google OAuth app (optional but enables "Sign in with Google" for GA4+GSC;
# without it, only the service-account path shows). One app serves all deployments.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Storage: the hub reuses MONGODB_URI above (an `analyticshub_config` collection).
# No Upstash/KV needed. Meta + Google Ads credentials are entered in the dashboard.

# --- Public site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email notifications (optional; leads/submissions notify when set) ---
# Sent over plain SMTP from our own mailbox — no third-party sending service.
# Leave SMTP_USER/SMTP_PASS empty and every send is a silent no-op.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Google App Password (16 chars, requires 2-Step Verification) — not the login password.
SMTP_PASS=
# From address. Gmail rewrites this unless it matches SMTP_USER or a verified alias.
# EMAIL_FROM=Payment Processor Guide <automations@davnoot.com>
# Where lead/submission notifications go — comma-separated for several owners.
# Falls back to SiteSettings.contactEmail when unset.
# LEADS_NOTIFY_EMAIL=gunin@davnoot.com,automations@davnoot.com
